{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitroinputmask"
  ],
  "ios": {
    "iosModuleName": "NitroInputMask"
  },
  "android": {
    "androidNamespace": [
      "nitroinputmask"
    ],
    "androidCxxLibName": "NitroInputMask"
  },
  "autolinking": {
    "NitroInputMask": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroInputMaskModule"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroInputMaskModule"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
